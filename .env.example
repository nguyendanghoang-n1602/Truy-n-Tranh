# Google Cloud Text-to-Speech API Configuration (Optional)
# Leave blank to use Browser SpeechSynthesis fallback.
# You can also enter this key directly in the UI Settings (saved in your browser's localStorage).
VITE_GOOGLE_TTS_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY_HERE

# Optional proxy endpoint if you use a backend proxy for Google Cloud TTS
VITE_GOOGLE_TTS_PROXY_URL=
